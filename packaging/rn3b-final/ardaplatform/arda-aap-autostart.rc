service arda_aap_session /system/bin/sh /product/bin/arda-aap-autostart
    class late_start
    user root
    group root system shell bluetooth wifi inet input graphics audio camera
    seclabel u:r:su:s0
    disabled
    restart_period 2

# Prewarm senderd after Android boot without activating the experimental
# allocator mapper bind. If its 60-second initial discovery wait expires,
# init restarts it two seconds later so it remains ready for the first AOAP
# attachment.
on property:sys.boot_completed=1
    start arda_aap_session

# Redundant recovery triggers for later USB gadget transitions.
on property:sys.usb.state=accessory
    start arda_aap_session

on property:sys.usb.state=accessory,adb
    start arda_aap_session

on property:sys.usb.config=accessory
    start arda_aap_session

on property:sys.usb.config=accessory,adb
    start arda_aap_session
