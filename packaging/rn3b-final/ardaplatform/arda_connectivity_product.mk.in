# ARDA device-wide connectivity transport core.
PRODUCT_PACKAGES += \
    ArdaPlatformPriv \
    arda_connectivityd \
    arda_connectivity_supervisor \
    arda_connectivityd_rc \
    arda_platform_privapp_permissions \
    arda_platform_default_permissions \
    arda_platform_sysconfig \
    arda_rn3b_permission_bootstrap \
    arda_rn3b_permission_bootstrap_rc \
    arda_aap_config

# ARDA_AAP_AUTOSTART_BEGIN
PRODUCT_PACKAGES += \
    arda_aap_autostart \
    arda_aap_autostart_rc
# ARDA_AAP_AUTOSTART_END

# ARDA_RPI4_HW_ENCODER_EXPERIMENTAL_BEGIN
# The vendor minigbm source and modules are retained for controlled tests.
# They are intentionally excluded from PRODUCT_PACKAGES because binding a
# vendor_file-backed library into the allocator APEX during boot caused
# SurfaceFlinger and mediaswcodec to abort with "gralloc-mapper is missing".
# ARDA_RPI4_HW_ENCODER_EXPERIMENTAL_END
